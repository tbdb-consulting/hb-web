---
pagination:
  data: trasa.strankyEtap
  size: 1
  alias: st
permalink: "{{ st.adresa }}index.html"
layout: zaklad.njk
eleventyComputed:
  titulek: "{% if st.jazyk == 'en' %}Stage {{ st.e.cislo }}: {{ st.e.nazev }}{% else %}Etapa {{ st.e.cislo }}: {{ st.e.nazev }}{% endif %}"
  metaPopis: "{% if st.jazyk == 'en' %}Stage {{ st.e.cislo }} of the Hory Bory race: {{ st.e.nazev }}, {{ st.e.delkaKm }} km, {{ st.e.prevyseni }} m of climbing.{% else %}Etapa {{ st.e.cislo }} závodu Hory Bory: {{ st.e.nazev }}, {{ st.e.delkaKm | cz }} km, převýšení {{ st.e.prevyseni }} m.{% endif %}"
  adresa: "{{ '/en/route/' if st.jazyk == 'en' else '/trasa/' }}"
  jazyk: "{{ st.jazyk }}"
  altCs: "{{ st.e.adresa }}"
  altEn: "{{ st.e.adresaEn }}"
---
{#- Stránka etapy v obou jazycích (20. 10. 2026). Tištěná karta dole zůstává česky – je to oficiální karta závodu. -#}
{%- set e = st.e -%}
{%- set jaz = st.jazyk -%}
{%- set en = jaz == "en" -%}
{%- set km = (e.delkaKm if en else (e.delkaKm | cz)) -%}
<meta name="hb-rok" content="{{ trasa.rokCislo }}">


<nav class="etapa-drobky" aria-label="{{ 'Kde jsi' | t(jaz) }}">
  <a href="{{ web.zaklad }}{{ '/en/route/' if en else '/trasa/' }}">{{ "Trasa a etapy" | t(jaz) }}</a> <span aria-hidden="true">›</span> {{ "Etapa" | t(jaz) }} {{ e.cislo }}
</nav>

<h1 class="etapa-nadpis"><span class="etapa-cislo">{{ e.cislo }}</span> {{ e.nazev }}</h1>

<ul class="etapa-cisla">
  <li><strong>{{ km }}&nbsp;km</strong><span>{{ "délka" | t(jaz) }}</span></li>
  <li><strong>{{ e.prevyseni }} m</strong><span>{{ "stoupání" | t(jaz) }}</span></li>
  <li><strong>{{ e.klesani }} m</strong><span>{{ "klesání" | t(jaz) }}</span></li>
  {% if e.penalizace %}<li><strong>{{ e.penalizace }}</strong><span>{{ "penalizace" | t(jaz) }}</span></li>{% endif %}
</ul>

{% if e.povrch %}<p class="etapa-povrch">{{ "Povrch:" | t(jaz) }} {{ e.povrchEn if en else e.povrch }}</p>{% endif %}

<section class="etapa-blok">
  <h2>{{ "Výškový profil" | t(jaz) }}</h2>
  <figure class="profil">
    <svg viewBox="0 0 {{ e.svg.S }} {{ e.svg.V }}" preserveAspectRatio="none" role="img"
         aria-label="{% if en %}Elevation profile of stage {{ e.cislo }}: starts at {{ e.profil.min }} m a.s.l., highest point {{ e.profil.max }} m a.s.l.{% else %}Výškový profil etapy {{ e.cislo }}: začíná v {{ e.profil.min }} m n. m., nejvýše {{ e.profil.max }} m n. m.{% endif %}">
      <path class="profil-plocha" d="{{ e.svg.plocha }}"></path>
      <path class="profil-cara" d="{{ e.svg.cara }}"></path>
    </svg>
    <div class="profil-osa">
      {% for o in e.svg.osa %}
      <span class="kotva-{{ o.kotva }}" style="left: {{ (o.x / e.svg.S * 100) | round(2) }}%">{{ o.km }}{% if o.jednotka %}&nbsp;km{% endif %}</span>
      {% endfor %}
    </div>
    <figcaption>
      <span>{{ e.start.kod | t(jaz) }} {{ e.start.nazev }} · {{ e.profil.startV }} {{ "m n. m." | t(jaz) }}</span>
      <span class="profil-vrchol">{{ "nejvýše" | t(jaz) }} {{ e.profil.max }} {{ "m n. m." | t(jaz) }}</span>
      <span>{{ e.cil.kod | t(jaz) }} {{ e.cil.nazev }} · {{ e.profil.cilV }} {{ "m n. m." | t(jaz) }}</span>
    </figcaption>
  </figure>
</section>

<section class="etapa-blok etapa-body">
  <div class="etapa-bod">
    <h2>Start</h2>
    <p class="etapa-misto"><span class="etapa-kod">{{ e.start.kod | t(jaz) }}</span> {{ e.start.nazev }}</p>
    {% if e.start.detail %}<p class="etapa-gps">{{ e.start.detail }}</p>{% endif %}
  </div>
  <div class="etapa-bod">
    <h2>{{ "Cíl" | t(jaz) }}</h2>
    <p class="etapa-misto"><span class="etapa-kod">{{ e.cil.kod | t(jaz) }}</span> {{ e.cil.nazev }}</p>
    {% if e.cil.detail %}<p class="etapa-gps">{{ e.cil.detail }}</p>{% endif %}
  </div>
</section>

{% set popis = e.popisEn if en else e.popis %}
{% if popis %}
<section class="etapa-blok">
  <h2>{{ "Trasa běžce" | t(jaz) }}</h2>
  <div class="text etapa-popis">{{ popis | safe }}</div>
</section>
{% endif %}


<section class="etapa-blok etapa-mapa">
  <h2>{{ "Mapa trasy" | t(jaz) }}</h2>
  <img src="{{ web.zaklad }}{{ e.obrazky.mapa }}" alt="{{ 'Mapa trasy etapy' | t(jaz) }} {{ e.cislo }}" loading="lazy" width="900" height="1100">
  {% if e.mapaUrl %}
  <div class="etapa-qr">
    <a href="{{ e.mapaUrl }}" rel="noopener"><img src="{{ web.zaklad }}{{ e.obrazky.qr }}" alt="{{ 'QR kód na trasu etapy v mapách' | t(jaz) }} {{ e.cislo }}" width="120" height="120"></a>
    <p>{{ "Trasa v mapě" | t(jaz) }}<br><a href="{{ e.mapaUrl }}" rel="noopener">{{ "otevřít na mapy.com" | t(jaz) }}</a></p>
  </div>
  {% endif %}
</section>

<section class="etapa-blok etapa-parkovani">
  <h2>{{ "Parkování v cíli" | t(jaz) }}</h2>
  <img src="{{ web.zaklad }}{{ e.obrazky.parkoviste }}" alt="{{ 'Letecký snímek parkoviště u cíle etapy' | t(jaz) }} {{ e.cislo }}" loading="lazy" width="700" height="450">
  {% if e.autoKm %}
  <p class="etapa-auto">{% if en %}By car from the previous handover {{ e.autoKm }}&nbsp;km, about {{ e.autoMin }} minutes.{% else %}Autem z předchozí předávky {{ e.autoKm | cz }}&nbsp;km, přibližně {{ e.autoMin }} minut.{% endif %}</p>
  {% endif %}
</section>

{% if e.useky.length %}
<section class="etapa-blok etapa-useky-blok">
  <h2>{{ "Úseky etapy" | t(jaz) }}</h2>
  <div class="table-responsive">
  <table class="etapa-useky">
    <thead>
      <tr><th>{{ "Od km" | t(jaz) }}</th><th>{{ "Do km" | t(jaz) }}</th><th>{{ "Délka" | t(jaz) }}</th><th>{{ "Ráz" | t(jaz) }}</th><th>{{ "Povrch" | t(jaz) }}</th><th>{{ "Sklon" | t(jaz) }}</th><th>{{ "Auto" | t(jaz) }}</th></tr>
    </thead>
    <tbody>
      {% for u in e.useky %}
      <tr>
        <td>{{ (u.od_m / 1000) | round(1) if en else ((u.od_m / 1000) | round(1) | cz) }}</td>
        <td>{{ (u.do_m / 1000) | round(1) if en else ((u.do_m / 1000) | round(1) | cz) }}</td>
        <td>{% if u.delka_m < 1000 %}{{ u.delka_m }}&nbsp;m{% else %}{{ (u.delka_m / 1000) | round(1) if en else ((u.delka_m / 1000) | round(1) | cz) }}&nbsp;km{% endif %}</td>
        <td>{{ u.raz | t(jaz) }}</td>
        <td>{{ u.povrch | t(jaz) }}</td>
        <td>{{ u.sklon_pct if en else (u.sklon_pct | cz) }}&nbsp;%</td>
        <td>{% if u.auto %}{{ "ano" | t(jaz) }}{% else %}{{ "ne" | t(jaz) }}{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  <p class="etapa-vysvetlivka">{{ "Sloupec „Auto“ říká, jestli se dá úsek objet autem — doprovod podle něj pozná, kde běžce uvidí." | t(jaz) }}</p>
</section>
{% endif %}

<nav class="etapa-sousedi" aria-label="{{ 'Další etapy' | t(jaz) }}">
  {% if e.predchozi %}<a class="etapa-zpet" href="{{ web.zaklad }}{{ e.predchozi.adresaEn if en else e.predchozi.adresa }}">‹ {{ e.predchozi.cislo }}. {{ e.predchozi.nazev }}</a>{% endif %}
  {% if e.dalsi %}<a class="etapa-vpred" href="{{ web.zaklad }}{{ e.dalsi.adresaEn if en else e.dalsi.adresa }}">{{ e.dalsi.cislo }}. {{ e.dalsi.nazev }} ›</a>{% endif %}
</nav>

<p class="etapa-tisk">
  {% if e.pdf %}<a class="c-btn" href="{{ web.zaklad }}{{ e.pdf }}">{{ "Stáhnout kartu etapy (PDF)" | t(jaz) }}</a>{% endif %}
  {% if e.gpx %}<a class="c-btn c-btn-vedlejsi" href="{{ web.zaklad }}{{ e.gpx }}" download>{{ "Stáhnout GPX" | t(jaz) }}</a>{% endif %}
</p>
<p class="etapa-tisk-pozn">{{ "Kartu je nejlepší vytisknout ze staženého PDF — má hotovou tiskovou podobu na dvě strany A4." | t(jaz) }}</p>

{#  Tištěná karta etapy. Na obrazovce se nezobrazuje, v tisku naopak nahrazuje
    celou stránku. Je to samostatná struktura — dva listy A4, každý s vlastní
    hlavičkou a patičkou — aby se nemusela ohýbat podoba webové stránky.  #}
<div class="karta" aria-hidden="true">
  {% set hlavicka %}
  <div class="karta-hlavicka">
    <img src="{{ web.zaklad }}/assets/etapy/karta-hlavicka.png" alt="">
    {#  Odznak etapy. Překrývá menší oranžové kolečko zapečené v hlavičce:
        po obvodu bílé slovo ETAPA, číslice vycentrovaná v horní polovině.  #}
    <svg class="karta-odznak" viewBox="0 0 100 100" role="img" aria-label="Etapa {{ e.cislo }}">
      <circle cx="50" cy="50" r="49" fill="#F7B211"/>
      <path id="oblouk-{{ e.cislo }}" fill="none" d="M 12 50 a 38 38 0 0 0 76 0"/>
      <text class="karta-odznak-cislo" x="50" y="48" text-anchor="middle">{{ e.cislo }}</text>
      <text class="karta-odznak-slovo">
        <textPath href="#oblouk-{{ e.cislo }}" startOffset="50%" text-anchor="middle">ETAPA</textPath>
      </text>
    </svg>
  </div>
  {% endset %}
  {% set paticka %}<div class="karta-paticka"><span>Hory Bory – Závod {{ trasa.rokCislo }}</span></div>{% endset %}

  <section class="karta-list">
    {{ hlavicka | safe }}
    <div class="karta-telo">
      <dl class="karta-radky">
        <dt>Start</dt><dd><b>{{ e.start.kod }}</b> {{ e.start.plny }}</dd>
        <dt>Cíl</dt><dd><b>{{ e.cil.kod }}</b> {{ e.cil.plny }}</dd>
        <dt>Trasa běžce</dt><dd class="karta-popis">{{ e.popis }}</dd>
        <dt>Délka, povrch,<br>stoupání, klesání</dt>
        <dd>{{ e.delkaKm | cz }}&nbsp;km, {{ e.povrch }},<br>stoupání {{ e.prevyseni }} m, klesání {{ e.klesani }} m</dd>
      </dl>

      <div class="karta-pas">
        <div class="karta-profil">
          <svg viewBox="0 0 {{ e.svg.S }} {{ e.svg.V }}" preserveAspectRatio="none">
            <path class="profil-plocha" d="{{ e.svg.plocha }}"></path>
            <path class="profil-cara" d="{{ e.svg.cara }}"></path>
          </svg>
          <div class="karta-vysky">
            {% for b in e.svg.popisky %}
            <span class="kotva-{{ b.kotva }}" style="left: {{ (b.x / e.svg.S * 100) | round(2) }}%">
              <strong>{{ b.v }}</strong><em>m n. m.</em>
            </span>
            {% endfor %}
          </div>
          <div class="karta-osa">
            {% for o in e.svg.osa %}
            <span class="kotva-{{ o.kotva }}" style="left: {{ (o.x / e.svg.S * 100) | round(2) }}%">{{ o.km }}{% if o.jednotka %} km{% endif %}</span>
            {% endfor %}
          </div>
        </div>
        <div class="karta-qr">
          <p>Cíl etapy – trasa pro auto</p>
          <img src="{{ web.zaklad }}{{ e.obrazky.qr }}" alt="">
        </div>
      </div>

      <img class="karta-parkoviste" src="{{ web.zaklad }}{{ e.obrazky.parkoviste }}" alt="">
    </div>
    {{ paticka | safe }}
  </section>

  <section class="karta-list">
    {{ hlavicka | safe }}
    <div class="karta-telo">
      <img class="karta-mapa" src="{{ web.zaklad }}{{ e.obrazky.mapa }}" alt="">
    </div>
    {{ paticka | safe }}
  </section>
</div>
