<div class="adm-stranka fo-stranka">
  <h1>Fotky – nahrát náhledy</h1>
  <p class="adm-sub">Vyber ročník a složku s fotkami. Prohlížeč každou fotku zmenší na 768 px, nahraje ji do úložiště a spáruje s katalogem fotek podle jména souboru. Originály zůstávají u tebe, nic se neposílá ve velké velikosti. Fotky, které v katalogu ještě nejsou, se do něj přidají.</p>
  <div class="fo-radek">
    <label>Ročník <select id="fo-rok"></select></label>
    <label>Fotograf (pro nové fotky) <input id="fo-fotograf" placeholder="např. Mego"></label>
  </div>
  <div id="fo-prehled" class="fo-prehled"><p class="adm-sub">Načítám…</p></div>
  <div class="fo-radek">
    <label class="fo-vyber">Vybrat složku <input type="file" id="fo-slozka" webkitdirectory multiple accept="image/jpeg,image/png,image/webp"></label>
    <label class="fo-vyber">nebo jednotlivé fotky <input type="file" id="fo-soubory" multiple accept="image/jpeg,image/png,image/webp"></label>
    <label><input type="checkbox" id="fo-jen-chybejici" checked> nahrát jen fotky, kterým náhled chybí</label>
  </div>
  <div id="fo-prubeh" class="fo-prubeh" hidden><progress id="fo-progress" max="1" value="0"></progress> <span id="fo-stav"></span></div>
  <ul id="fo-chyby" class="fo-chyby"></ul>

  <h2 class="fo-nadpis">Fotky ročníku na webu</h2>
  <div class="fo-radek">
    <label>Co dělám <select id="fo-rezim"><option value="uvodni">Úvodní fotka ročníku (na dlaždici v galerii)</option><option value="trideni">Třídění na Start / Trasa / Cíl</option><option value="kampan">Výběr do kampaně na sítě (feed 4:5, story 9:16)</option></select></label>
  </div>
  <p class="adm-sub" id="fo-napoveda">Klikni na fotku a potvrď. Na webu se změna objeví po dalším sestavení webu.</p>
  <div id="fo-uvodni" class="fo-uvodni"></div>
  <div class="fo-filtr" id="fo-filtr" hidden>
    <button type="button" data-s="" class="fo-akt">Vše</button><button type="button" data-s="start">Start</button><button type="button" data-s="trasa">Trasa</button><button type="button" data-s="cil">Cíl</button><button type="button" data-s="-">Nezařazené</button><button type="button" data-s="predavka">Předávka</button>
  </div>
  <div class="fo-filtr" id="fo-filtr-kampan" hidden>
    <button type="button" data-k="" class="fo-akt">Vše</button><button type="button" data-k="feed">Kampaň feed</button><button type="button" data-k="story">Kampaň story</button><button type="button" data-k="mimo">Mimo kampaň</button><button type="button" data-k="predavka">Předávka</button>
    <span class="fo-pocet" id="fo-kampan-pocet"></span>
  </div>
  <div id="fo-mrizka" class="fo-mrizka"></div>
</div>
<dialog id="fo-lb" class="fo-lb" aria-label="Fotka ve velkém">
  <div class="fo-lb-hlava"><span id="fo-lb-nazev"></span><button type="button" class="fo-lb-x" data-lb="zavrit" aria-label="Zavřít">×</button></div>
  <div class="fo-lb-stred">
    <button type="button" class="fo-lb-sipka" id="fo-lb-pred" data-lb="pred" aria-label="Předchozí fotka">‹</button>
    <div class="fo-lb-plocha" id="fo-lb-plocha"><img id="fo-lb-img" alt="" draggable="false">
      <div class="fo-lb-ramec" id="fo-lb-ramec" hidden>
        <i class="fo-lb-l fo-v1"></i><i class="fo-lb-l fo-v2"></i><i class="fo-lb-l fo-h1"></i><i class="fo-lb-l fo-h2"></i>
        <b class="fo-lb-zona fo-hore"></b><b class="fo-lb-zona fo-dole"></b>
        <span class="fo-lb-roh" data-roh="tl"></span><span class="fo-lb-roh" data-roh="tr"></span><span class="fo-lb-roh" data-roh="bl"></span><span class="fo-lb-roh" data-roh="br"></span>
      </div>
    </div>
    <button type="button" class="fo-lb-sipka" id="fo-lb-dalsi" data-lb="dalsi" aria-label="Další fotka">›</button>
  </div>
  <div class="fo-lb-ovladani" id="fo-lb-ovladani"></div>
  <p class="fo-lb-napoveda" id="fo-lb-napoveda"></p>
</dialog>
