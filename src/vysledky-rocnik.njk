---
pagination:
  data: obsah.archivStranky
  size: 1
  alias: st
permalink: "{{ st.adresa }}index.html"
layout: zaklad.njk
eleventyComputed:
  titulek: "{{ 'Hory Bory results' if st.jazyk == 'en' else 'Výsledky Hory Bory' }} {{ st.r.letopocet }}"
  metaPopis: "{% if st.jazyk == 'en' %}Overall results of the Hory Bory relay run {{ st.r.letopocet }}: team ranking and times on the course.{% else %}Celkové výsledky štafetového běhu Hory Bory {{ st.r.letopocet }}: pořadí týmů a časy na trase.{% endif %}"
  adresa: "{{ st.adresa }}"
  jazyk: "{{ st.jazyk }}"
  altCs: "{{ st.altCs }}"
  altEn: "{{ st.altEn }}"
---
{# Archiv výsledků jednoho ročníku z výsledkové listiny (tabulka web_vysledky_archiv). Keksa 12. 10. 2026, angličtina 20. 10. 2026. #}
{%- set r = st.r -%}
{%- set jaz = st.jazyk -%}
{%- set en = jaz == "en" -%}
<p class="drobecky"><a href="{{ web.zaklad }}{{ '/en/results/' if en else '/vysledky/' }}">{{ "Výsledky" | t(jaz) }}</a> › {{ r.letopocet }}</p>
<h1>{{ "Výsledky Hory Bory" | t(jaz) }} {{ r.letopocet }}</h1>
<p>{% if en %}Overall ranking of {{ r.tymy.length }} teams according to the official result list.{% if r.sKategorii %} The letter Z marks an all-female team.{% endif %}{% else %}Celkové pořadí {{ r.tymy.length }} týmů podle výsledkové listiny.{% if r.sKategorii %} Písmeno Z označuje ženský tým.{% endif %}{% endif %}</p>
<div class="table-responsive">
<table class="archiv-tabulka">
  <thead><tr><th>#</th>{% if r.sCisly %}<th class="archiv-cislo">{{ "Číslo" | t(jaz) }}</th>{% endif %}<th>{{ "Tým" | t(jaz) }}</th>{% if r.sKategorii %}<th>{{ "Kat." | t(jaz) }}</th>{% endif %}<th>{{ "Čas na trase" | t(jaz) }}</th></tr></thead>
  <tbody>
  {% for t in r.tymy %}
    <tr{% if t.kategorie == "Z" %} class="archiv-z"{% endif %}><td>{{ t.poradi }}.</td>{% if r.sCisly %}<td class="archiv-cislo">{{ t.cislo }}</td>{% endif %}<td>{{ t.tym }}</td>{% if r.sKategorii %}<td>{{ "Z" if t.kategorie == "Z" else "" }}</td>{% endif %}<td class="archiv-cas">{{ t.cas }}</td></tr>
  {% endfor %}
  </tbody>
</table>
</div>
<p class="archiv-dalsi">{{ "Další ročníky:" | t(jaz) }} {% for x in obsah.archiv %}{% if x.rok != r.rok %}<a href="{{ web.zaklad }}{{ ('/en/results/' + x.letopocet + '/') if en else x.adresa }}">{{ x.letopocet }}</a>{% if not loop.last %} · {% endif %}{% endif %}{% endfor %}</p>
